# AeroFlow — production environment
#
# Copy each key into Vercel → Project → Settings → Environment Variables,
# scoped to "Production". Values below are placeholders; never commit real ones.
#
# Only NEXT_PUBLIC_* variables reach the browser. Everything else stays on the
# server — do not rename any of them to NEXT_PUBLIC_.

# ─── The public origin ────────────────────────────────────────────────────────
# Your Vercel domain, e.g. https://your-project.vercel.app (no trailing slash).
# This is the single most important value here: boarding-pass
# QR codes encode it, confirmation email links point at it, and Stripe returns
# travellers to it. A code generated with the wrong origin is unscannable.
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Origins the browser may be redirected back to after Stripe checkout. The
# request's own origin is used when it appears here, so add every hostname the
# app is genuinely served on (apex and www if both resolve).
APP_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ─── Database (Neon) ──────────────────────────────────────────────────────────
# Use the POOLED connection string (host contains "-pooler"). A direct
# connection exhausts Postgres slots under serverless concurrency.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# ─── Redis (Upstash) ──────────────────────────────────────────────────────────
# Seat locks and the live-availability pub/sub. Must be the REST credentials.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ─── Authentication (Clerk) — DEVELOPMENT INSTANCE ────────────────────────────
# Deliberately the same pk_test_ / sk_test_ keys as local: this deployment is a
# staging build, not a client hand-off. Copy the values already in .env.local.
#
# A development instance serves its Frontend API from *.clerk.accounts.dev and
# is not bound to one domain, so it will run on a vercel.app URL — but it is
# rate-limited and shows Clerk's development banner. Switch to a production
# instance only when this goes to a real client.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# ─── Payments (Stripe) — TEST MODE ────────────────────────────────────────────
# Deliberately the sk_test_ key. No real money moves; pay with 4242 4242 4242 4242.
#
# STRIPE_WEBHOOK_SECRET must be the secret Stripe shows for the TEST endpoint
# pointing at https://your-domain.com/api/webhooks/stripe. A secret copied from
# a different endpoint fails signature verification on every delivery, and the
# only symptom is that bookings never appear.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY is NOT needed: checkout is created
# server-side and the browser is redirected to Stripe's hosted page, so no
# publishable key is ever used in this app.

# ─── Confirmation email (Gmail SMTP via Nodemailer) ───────────────────────────
# EMAIL_APP_PASSWORD is a Gmail App Password (16 chars), not the account
# password. Spaces are tolerated. Requires 2-Step Verification on the account.
# https://myaccount.google.com/apppasswords
EMAIL_APP=you@gmail.com
EMAIL_APP_PASSWORD=

# ─── Travel concierge (OpenRouter) ────────────────────────────────────────────
# Optional. Without it the Ask AI panel errors; the rest of the app is fine.
# The free tier has a daily request cap — add credits for production use.
OPENROUTER_API_KEY=
# Optional overrides. The embedding model MUST return 1536 dimensions to match
# the pgvector column, or semantic search breaks.
# OPENROUTER_EMBEDDING_MODEL=
# OPENROUTER_CHAT_MODEL=

# Optional: point the same code at a different SMTP provider.
# Gmail App Passwords get revoked the moment Google suspects exposure, and
# switching 2-Step Verification off kills every one of them at once — both
# surface as "535 BadCredentials" with a credential that looks correct.
# Leave unset for Gmail. Examples:
#   Brevo      EMAIL_SMTP_HOST=smtp-relay.brevo.com   EMAIL_SMTP_PORT=587
#   SendGrid   EMAIL_SMTP_HOST=smtp.sendgrid.net      EMAIL_SMTP_PORT=587
#   Mailtrap   EMAIL_SMTP_HOST=sandbox.smtp.mailtrap.io EMAIL_SMTP_PORT=2525
# EMAIL_SMTP_HOST=
# EMAIL_SMTP_PORT=
