{
  "name": "booking-ticket",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "db:seed-guides": "tsx --env-file=.env.local scripts/seed-guides.mts",
    "ai:models": "tsx --env-file=.env.local scripts/list-free-models.mts",
    "db:seed": "tsx --env-file=.env.local scripts/seed.mts",
    "check:locks": "tsx --env-file=.env.local scripts/check-seat-locks.mts",
    "qa:realtime": "node scripts/qa/realtime-two-sessions.mjs",
    "check:origins": "tsx scripts/check-app-origin.mts",
    "qa:checkout": "node scripts/qa/checkout-return.mjs",
    "db:backfill-tokens": "tsx --env-file=.env.local scripts/backfill-verification-tokens.mts",
    "qa:verify": "tsx --env-file=.env.local scripts/qa/verify-flow.mts",
    "qa:scan": "node --env-file=.env.local scripts/qa/scan-boarding-pass.mjs",
    "qa:email": "tsx --env-file=.env.local scripts/qa/preview-email.mts",
    "qa:mailer": "tsx --env-file=.env.local scripts/qa/check-mailer.mts",
    "qa:email-send": "tsx --env-file=.env.local scripts/qa/send-to-sink.mts",
    "qa:email-real": "tsx --conditions=react-server --env-file=.env.local scripts/qa/send-real-email.mts",
    "qa:assistant": "tsx --env-file=.env.local scripts/qa/check-assistant.mts",
    "email:resend": "tsx --conditions=react-server --env-file=.env.local scripts/resend-confirmation.mts",
    "qa:prove-send": "tsx --conditions=react-server --env-file=.env.local scripts/qa/prove-send-path.mts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.1",
    "@neondatabase/serverless": "^1.1.0",
    "@upstash/redis": "^1.38.4",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.4",
    "nodemailer": "^10.0.1",
    "openai": "^7.10.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "^22.6.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
