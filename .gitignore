# Repository root ignores. The Next.js app keeps its own .gitignore in
# booking-ticket/, and its rules are relative to that directory.

# ─── Secrets ──────────────────────────────────────────────────────────────────
# Belt and braces: the app already ignores these, but a root-level rule means a
# stray .env anywhere in the tree can never be staged by accident.
.env
.env.*
!.env.production.example

# ─── Dependencies and build output ────────────────────────────────────────────
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo

# ─── Agent tooling ────────────────────────────────────────────────────────────
# Vendored third-party skill packages and local agent state. Not project source,
# reinstallable from skills-lock.json, and large.
.agents/
.claude/
.gstack/
.clerk/

# ─── Local environment ────────────────────────────────────────────────────────
.DS_Store
*.pem
.vercel/
.idea/
.vscode/

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vercel
.env*
